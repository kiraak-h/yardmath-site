# ==============================================================================
# YardMath Environment Configuration Template
# ==============================================================================

# [REQUIRED FOR PRODUCTION LAUNCH]
# The canonical public HTTPS domain of the website (no trailing slash).
# When this variable is omitted or empty, YardMath dynamically enforces a strict
# staging protection mode (Disallow: / across all search and AI crawlers, and noindex/nofollow).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# [OPTIONAL / RECOMMENDED BEFORE LAUNCH]
# A monitored support and editorial contact email address.
# Displayed on /contact/ and used in mailto links on /about/. If omitted, an honest
# site-owner setup notice is rendered instead of a broken or fake address.
NEXT_PUBLIC_CONTACT_EMAIL=

# [OPTIONAL: AI CRAWLER CONFIGURATION]
# Controls whether OpenAI's model-training crawler (GPTBot) is allowed to scrape content.
# Defaults to false (disallowed) to protect editorial content from unauthorized AI model training.
# Note: ChatGPT Search crawler (OAI-SearchBot) is separate and remains allowed for live search citations.
ALLOW_GPTBOT=false

# Controls whether Google-Extended is allowed to crawl content for Gemini / Vertex AI model training.
# Defaults to false (disallowed).
# Note: Disallowing Google-Extended does NOT affect standard Google Search indexing or Google AI Overviews,
# which are handled by standard Googlebot.
ALLOW_GOOGLE_EXTENDED=false
